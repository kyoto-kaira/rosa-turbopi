# Existing rosbridge endpoint; no robot container changes required.
ROSBRIDGE_HOST=127.0.0.1
ROSBRIDGE_PORT=9090
ROSBRIDGE_SECURE=false
# Required only for chat. Choose a tool-calling model supported by your provider.
OPENAI_API_KEY=
LLM_MODEL=
# Optional OpenAI-compatible endpoint
OPENAI_BASE_URL=

# rosbridge: real robot; mock: simulation without a robot connection
# Set ENABLE_MOTION=false for read-only real robot access.
ROBOT_BACKEND=rosbridge

# Real motion is enabled by default. Stop on disconnect is NOT guaranteed.
ENABLE_MOTION=true
ROSBRIDGE_TIMEOUT_S=5

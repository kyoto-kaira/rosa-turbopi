# Existing rosbridge endpoint; no robot container changes required.
ROSBRIDGE_HOST=127.0.0.1
ROSBRIDGE_PORT=9090
ROSBRIDGE_SECURE=false
# Required only for chat. Choose a tool-calling model supported by your provider.
OPENAI_API_KEY=
LLM_MODEL=
# Optional OpenAI-compatible endpoint
OPENAI_BASE_URL=

# rosbridge: real robot; mock: simulation without a robot connection
# Set ENABLE_MOTION=false for read-only real robot access.
ROBOT_BACKEND=rosbridge

# Real motion is enabled by default. Stop on disconnect is NOT guaranteed.
ENABLE_MOTION=true
ROSBRIDGE_TIMEOUT_S=5

AGENT_MAX_ITERATIONS=15

AGENT_VERBOSE=false

# Optional voice extension; shares OPENAI_API_KEY, ignores OPENAI_BASE_URL.
VOICE_TRANSCRIBE_MODEL=gpt-transcribe
# Object detection is included in the standard installation. Defaults shown.
# Still images come from the existing web_video_server on ROSBRIDGE_HOST.
CAMERA_PORT=8080
CAMERA_TOPIC=/image_raw
CAMERA_TIMEOUT_S=5
# Relative to the working directory. Docker Compose mounts ./weights at /data/weights.
# Missing weights and text encoders are downloaded on first detection (internet required).
YOLOE_MODEL=weights/yoloe-26s-seg.pt
